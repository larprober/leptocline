#!/usr/bin/env bash
# leptofetch — the system readout Linux Leptocline prints on every new shell.
# No dependencies beyond coreutils: everything comes out of /proc and /etc.
#
# The logo is a truecolor half-block rendering of the Leptocline penguin,
# generated by tools/render-assets.js and shipped at:
ART_FILE=/usr/share/leptocline/penguin.ansi

set -u

C=$'\e[38;2;25;198;214m'   # cyan accent
K=$'\e[90m'; N=$'\e[0m'; L=$'\e[1;38;2;25;198;214m'; W=$'\e[97m'
ART_COLS=40                # printable width of every art line (blocks + spaces)

# --- load the penguin art (each line is ART_COLS printable cells wide) --------
ART=()
if [ -r "$ART_FILE" ]; then
  mapfile -t ART < "$ART_FILE"
fi
if [ ${#ART[@]} -eq 0 ]; then
  # Fallback if the art file is missing: a small mono penguin.
  ART_COLS=16
  ART=(
    "     ${W}.--.${N}"
    "    ${W}|o_o|${N}"
    "    ${W}|:_/|${N}"
    "   ${W}//   \\\\${N}"
    "  ${W}(|     |)${N}"
    " ${W}/'\\_   _/\`\\\\${N}"
    " ${W}\\___)=(___/${N}"
  )
fi
blank=$(printf '%*s' "$ART_COLS" '')

# --- gather system facts ------------------------------------------------------
kv() { INFO+=("${L}${1}${N}${K}:${N} ${2}"); }

. /etc/os-release 2>/dev/null || true
host=$(cat /etc/hostname 2>/dev/null || echo localhost)

up=0; read -r up _ < /proc/uptime 2>/dev/null || true; up=${up%.*}

mem_total=$(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo 2>/dev/null)
mem_avail=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo 2>/dev/null)
cpu=$(awk -F': ' '/model name/{print $2; exit}' /proc/cpuinfo 2>/dev/null)
cores=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)
pkgs=$(dpkg-query -f '.\n' -W 2>/dev/null | wc -l)
root_use=$(df -h / 2>/dev/null | awk 'NR==2{print $3" of "$2" ("$5")"}')
gpu=$(lspci 2>/dev/null | awk -F': ' '/VGA|3D controller/{print $2; exit}')

INFO=()
INFO+=("${L}${USER:-$(id -un)}${N}${K}@${N}${L}${host}${N}")
INFO+=("${K}────────────────────────────${N}")
kv "os      " "${PRETTY_NAME:-Linux Leptocline}"
kv "base    " "Debian ${DEBIAN_BASE:-trixie}"
kv "kernel  " "$(uname -r)"
kv "uptime  " "$(printf '%dh %dm' $((up / 3600)) $((up % 3600 / 60)))"
kv "packages" "${pkgs:-0} (dpkg)"
kv "shell   " "$(basename "${SHELL:-sh}")"
[ -n "${XDG_CURRENT_DESKTOP:-}" ] && kv "desktop " "${XDG_CURRENT_DESKTOP}"
[ -n "${cpu:-}" ] && kv "cpu     " "${cpu} (${cores:-?})"
[ -n "${gpu:-}" ] && kv "gpu     " "${gpu}"
[ -n "${mem_total:-}" ] && kv "memory  " "$((mem_total - mem_avail)) / ${mem_total} MiB"
[ -n "${root_use:-}" ] && kv "disk    " "${root_use}"
INFO+=("")
swatch=""
for c in 0 4 6 12 14 15 8; do swatch+=$'\e[48;5;'"${c}"$'m   '; done
INFO+=("${swatch}${N}")

# Vertically centre the info panel against the taller art block.
pad=$(( (${#ART[@]} - ${#INFO[@]}) / 2 ))
if [ "$pad" -gt 0 ]; then
  padded=(); for ((i = 0; i < pad; i++)); do padded+=(""); done
  INFO=("${padded[@]}" "${INFO[@]}")
fi

rows=${#ART[@]}; [ ${#INFO[@]} -gt "$rows" ] && rows=${#INFO[@]}

# --- render art beside info (art lines carry their own colour + reset) --------
echo
for ((i = 0; i < rows; i++)); do
  left=${ART[i]:-$blank}
  printf '  %s%s   %s\n' "$left" "$N" "${INFO[i]:-}"
done
echo
