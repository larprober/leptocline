#!/usr/bin/env bash
# leptofetch — the system readout Linux Leptocline prints on every new shell.
# No dependencies beyond coreutils: everything comes out of /proc and /etc.

set -u

W=$'\e[97m'; B=$'\e[38;2;20;54;238m'; K=$'\e[90m'; N=$'\e[0m'; L=$'\e[1;38;2;60;110;255m'
COL=26

ART=(
'.-"""-.'
'.-` o   o `-.'
'/     (_)     \'
'|             |'
'\           /'
'.-`             `-.'
'/                 \'
'|                 |'
'|                 |'
'\                 /'
'`-._         _.-`'
'`-._   _.-`'
'__/  `---`  \__'
'(___/       \___)'
)

center() { # $1 text, $2 width
  local len=${#1} left
  left=$(( ($2 - len) / 2 ))
  printf '%*s%s%*s' "$left" '' "$1" "$(( $2 - len - left ))" ''
}

kv() { INFO+=("${L}${1}${N}${K}:${N} ${2}"); }

. /etc/os-release 2>/dev/null || true
host=$(cat /etc/hostname 2>/dev/null || echo localhost)

up=0
read -r up _ < /proc/uptime 2>/dev/null || true
up=${up%.*}

mem_total=$(awk '/MemTotal/{print int($2/1024)}' /proc/meminfo 2>/dev/null)
mem_avail=$(awk '/MemAvailable/{print int($2/1024)}' /proc/meminfo 2>/dev/null)
cpu=$(awk -F': ' '/model name/{print $2; exit}' /proc/cpuinfo 2>/dev/null)
cores=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)
pkgs=$(dpkg-query -f '.\n' -W 2>/dev/null | wc -l)
root_use=$(df -h / 2>/dev/null | awk 'NR==2{print $3" used of "$2" ("$5")"}')
gpu=$(lspci 2>/dev/null | awk -F': ' '/VGA|3D controller/{print $2; exit}')

INFO=()
INFO+=("${L}${USER:-$(id -un)}${N}${K}@${N}${L}${host}${N}")
INFO+=("${K}$(printf '%.0s-' $(seq 1 34))${N}")
kv "os      " "${PRETTY_NAME:-Linux Leptocline}"
kv "base    " "Debian ${DEBIAN_BASE:-trixie}"
kv "kernel  " "$(uname -r)"
kv "uptime  " "$(printf '%dh %dm' $((up / 3600)) $((up % 3600 / 60)))"
kv "packages" "${pkgs:-0} (dpkg)"
kv "shell   " "$(basename "${SHELL:-sh}")"
[ -n "${XDG_CURRENT_DESKTOP:-}" ] && kv "desktop " "${XDG_CURRENT_DESKTOP}"
[ -n "${cpu:-}" ] && kv "cpu     " "${cpu} (${cores:-?})"
[ -n "${gpu:-}" ] && kv "gpu     " "${gpu}"
[ -n "${mem_total:-}" ] && kv "memory  " "$((mem_total - mem_avail)) MiB / ${mem_total} MiB"
[ -n "${root_use:-}" ] && kv "disk    " "${root_use}"
INFO+=("")
swatch=""
for c in 0 4 12 15 8; do swatch+=$'\e[48;5;'"${c}"$'m   '; done
INFO+=("${swatch}${N}")

rows=${#ART[@]}
[ ${#INFO[@]} -gt "$rows" ] && rows=${#INFO[@]}

echo
for ((i = 0; i < rows; i++)); do
  line=$(center "${ART[i]:-}" "$COL")
  line=${line/(_)/${B}(_)${W}}
  line=${line/(___\//${B}(___\/}
  line=${line/\___)/\___)${W}}
  printf '  %s%s%s  %s\n' "$W" "$line" "$N" "${INFO[i]:-}"
done
echo
